{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "feature-flags-api",
  "main": "src/adapters/cloudflare/worker.ts",
  "compatibility_date": "2026-10-15",
  // pg needs Node's net/tls/crypto shims.
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "PROJECT_HUB", "class_name": "ProjectHub" }],
  },
  // SQLite storage: the only Durable Object backend on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectHub"] }],
  "hyperdrive": [
    // Placeholder until the real config exists (created with --caching-disabled).
    // Local dev reads CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE instead.
    { "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" },
  ],
  "vars": { "GIT_SHA": "dev" },
}
