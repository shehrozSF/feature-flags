{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "feature-flags-api",
  "main": "src/adapters/cloudflare/worker.ts",
  "compatibility_date": "2026-10-15",
  // pg needs Node's net/tls/crypto shims.
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "PROJECT_HUB", "class_name": "ProjectHub" }],
  },
  // SQLite storage: the only Durable Object backend on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectHub"] }],
  "hyperdrive": [
    // Points at Neon (direct, unpooled URL), created with --caching-disabled (ADR 0013).
    // Not a secret: useless without the account. Local dev and tests read
    // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE instead.
    { "binding": "HYPERDRIVE", "id": "4dfdb6124b0d43da8d30f6323cde3d36" },
  ],
  // The deploy job overrides this with the commit (--var GIT_SHA:<sha>).
  // DASHBOARD_ORIGIN: the only origin allowed to call admin routes from a browser (spec §6.4).
  "vars": { "GIT_SHA": "dev", "DASHBOARD_ORIGIN": "https://shehrozsf.github.io" },
  // Workers Logs: keeps our JSON log lines searchable for 3 days. Free plan: 200,000
  // events a day (verified 2026-11-11), above the 100,000 requests a day Workers allow.
  "observability": { "enabled": true },
}
