{
  "name": "@ff/api",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p src/adapters/node && tsc --noEmit -p src/adapters/cloudflare && tsc --noEmit -p test-workers",
    "cf:types": "wrangler types --strict-vars=false src/adapters/cloudflare/worker-configuration.d.ts",
    "cf:dev": "wrangler dev",
    "dev": "tsx watch src/adapters/node/server.ts",
    "start": "tsx src/adapters/node/server.ts",
    "migrate": "tsx src/adapters/node/migrate-cli.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@ff/contracts": "workspace:*",
    "@ff/eval-core": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.14",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.2.1",
    "wrangler": "^4.156.0"
  }
}
