# Copy to .env (git ignores it) and fill in. See README.md for where each value comes from.

# ngrok dashboard → Your Authtoken
NGROK_AUTHTOKEN=
# ngrok dashboard → Domains: your free static domain, without https://
NGROK_DOMAIN=

# Discord: channel settings → Integrations → Webhooks → New Webhook → Copy Webhook URL
DISCORD_WEBHOOK_URL=

# The project's admin key (dashboard sandbox: see README.md). Used by the daily summary.
FF_ADMIN_KEY=
# The "secret" from PUT /v1/webhook (shown once). Verifies every event.
FF_WEBHOOK_SECRET=

# Optional
# FF_API_URL=https://feature-flags-api.shehrozsf.workers.dev
# TIMEZONE=Asia/Karachi
